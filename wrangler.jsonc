{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memegenscript",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // Template images and fonts are served as static assets (too large to bundle).
  // `run_worker_first` makes every request hit the Worker; assets are only read
  // through the ASSETS binding.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Image rendering is CPU heavy (animated GIF/WebP especially). The default
  // 30 s CPU limit on the paid plan is fine for most memes; raise if needed.
  "limits": {
    "cpu_ms": 30000
  },

  // The custom domain memegenscript.com is attached in the Cloudflare dashboard.
  // Don't declare it as a route here: `wrangler dev` would then treat local
  // requests as coming from that host and the DOMAIN override would apply locally.

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    // "true" enables debug rendering aids (bounding boxes, /test page, no caching)
    "DEBUG": "false",
    // Name shown on the web pages and in social cards
    "SITE_NAME": "Memegenscript",
    // Source repository linked from the pages (set to "" to hide)
    "REPO_URL": "https://github.com/terryds/memegenscript",
    // Public origin used for absolute URLs (canonical, sitemap, API examples).
    // Ignored for requests to localhost, so `wrangler dev` and tests keep their origin.
    "DOMAIN": "https://memegenscript.com",
    "DEFAULT_STATIC_EXTENSION": "png",
    "DEFAULT_ANIMATED_EXTENSION": "gif",
    // Seconds to keep rendered images in the edge cache
    "CACHE_TTL": "86400"
    // Set REMOTE_TRACKING_URL and BUGSNAG_API_KEY via `wrangler secret put`
  },

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ]
}
