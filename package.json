{
  "name": "memegenscript",
  "version": "1.0.0",
  "private": true,
  "description": "Free meme generator on Cloudflare Workers: in-browser editor for 450+ templates plus a URL-based meme API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:templates": "tsx scripts/build-templates.ts",
    "build:characters": "tsx scripts/build-characters.ts",
    "build:manifests": "npm run build:templates && npm run build:characters",
    "fetch:descriptions": "tsx scripts/fetch-descriptions.ts",
    "predev": "npm run build:manifests",
    "dev": "wrangler dev",
    "predeploy": "npm run build:manifests",
    "deploy": "wrangler deploy",
    "pretest": "npm run build:manifests",
    "test": "vitest run",
    "pretypecheck": "npm run build:manifests",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "emojilib": "^2.4.0",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.40.0",
    "yaml": "^2.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terryds/memegenscript"
  },
  "keywords": [
    "meme",
    "meme-generator",
    "cloudflare-workers",
    "api",
    "canvas"
  ]
}
